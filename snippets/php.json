{
  "Laravel Controller Complete Resource": {
    "prefix": "crresource",
    "body": [
      "<?php",
      "",
      "namespace App\\Http\\Controllers;",
      "",
      "use App\\Models\\${1:ModelName};",
      "use Illuminate\\Http\\Request;",
      "",
      "class ${1:ModelName}Controller extends Controller",
      "{",
      "    public function index()",
      "    {",
      "        \\$items = ${1:ModelName}::latest()->paginate(10);",
      "        return view('${2:view_folder}.index', compact('items'));",
      "    }",
      "",
      "    public function create()",
      "    {",
      "        return view('${2:view_folder}.create');",
      "    }",
      "",
      "    public function store(Request \\$request)",
      "    {",
      "        \\$validated = \\$request->validate([",
      "            '${3:title}' => 'required|string|max:255',",
      "            '${4:image}' => 'nullable|image|mimes:jpg,jpeg,png,webp|max:2048',",
      "        ]);",
      "",
      "        if (\\$request->hasFile('${4:image}')) {",
      "            \\$validated['${4:image}'] = \\$request->file('${4:image}')->store('${2:view_folder}', 'public');",
      "        }",
      "",
      "        ${1:ModelName}::create(\\$validated);",
      "",
      "        return redirect()->route('${5:route_prefix}.index')->with('success', 'Data created successfully.');",
      "    }",
      "",
      "    public function edit(${1:ModelName} \\$${6:variable})",
      "    {",
      "        return view('${2:view_folder}.edit', compact('${6:variable}'));",
      "    }",
      "",
      "    public function update(Request \\$request, ${1:ModelName} \\$${6:variable})",
      "    {",
      "        \\$validated = \\$request->validate([",
      "            '${3:title}' => 'required|string|max:255',",
      "            '${4:image}' => 'nullable|image|mimes:jpg,jpeg,png,webp|max:2048',",
      "        ]);",
      "",
      "        if (\\$request->hasFile('${4:image}')) {",
      "            \\$validated['${4:image}'] = \\$request->file('${4:image}')->store('${2:view_folder}', 'public');",
      "        }",
      "",
      "        \\$${6:variable}->update(\\$validated);",
      "",
      "        return redirect()->route('${5:route_prefix}.index')->with('success', 'Data updated successfully.');",
      "    }",
      "",
      "    public function destroy(${1:ModelName} \\$${6:variable})",
      "    {",
      "        \\$${6:variable}->delete();",
      "        return redirect()->back()->with('success', 'Data deleted successfully.');",
      "    }",
      "}"
    ],
    "description": "Full Laravel CRUD Controller Class"
  },

  "Laravel Public Contact/Inbox Store": {
    "prefix": "crcontact",
    "body": [
      "public function store(Request \\$request)",
      "{",
      "    \\$validated = \\$request->validate([",
      "        'name' => 'required|string|max:255',",
      "        'email' => 'required|email|max:255',",
      "        'subject' => 'required|string|max:255',",
      "        'message' => 'required|string',",
      "    ]);",
      "",
      "    ${1:Inbox}::create(\\$validated);",
      "",
      "    return redirect()->back()->with('success', 'Your message has been sent!');",
      "}"
    ],
    "description": "Public Form Submit Controller Action"
  },

  "Laravel Migration Table Schema": {
    "prefix": "migschema",
    "body": [
      "Schema::create('${1:table_name}', function (Blueprint \\$table) {",
      "    \\$table->id();",
      "    \\$table->string('${2:title}');",
      "    \\$table->text('${3:description}')->nullable();",
      "    \\$table->string('${4:image}')->nullable();",
      "    \\$table->timestamps();",
      "});"
    ],
    "description": "Migration Schema Helper"
  },

  "Laravel Routes Admin Group": {
    "prefix": "rtgroup",
    "body": [
      "Route::middleware(['auth'])->prefix('admin')->group(function () {",
      "    Route::get('/dashboard', function () {",
      "        return view('dashboard');",
      "    })->name('dashboard');",
      "",
      "    Route::resource('${1:news}', ${2:NewsController}::class)->names('${3:news-admin}');",
      "    Route::resource('${4:galleries}', ${5:GalleryController}::class)->names('${6:galleries-admin}');",
      "});"
    ],
    "description": "Admin Middleware Route Group with Resources"
  }
}
