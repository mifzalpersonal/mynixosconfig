  "Blade Index Table List": {
    "prefix": "bltable",
    "body": [
      "@extends('${1:layouts.admin}')",
      "",
      "@section('content')",
      "<div class=\"d-flex justify-between align-items-center mb-3\">",
      "    <h2>${2:Management Title}</h2>",
      "    <a href=\"{{ route('${3:route_prefix}.create') }}\" class=\"btn btn-primary\">Add New</a>",
      "</div>",
      "",
      "<div class=\"card shadow-sm\">",
      "    <div class=\"card-body\">",
      "        <table class=\"table table-bordered table-striped\">",
      "            <thead>",
      "                <tr>",
      "                    <th>#</th>",
      "                    <th>Image</th>",
      "                    <th>Title</th>",
      "                    <th>Actions</th>",
      "                </tr>",
      "            </thead>",
      "            <tbody>",
      "                @forelse(\\$items as \\$item)",
      "                    <tr>",
      "                        <td>{{ \\$loop->iteration }}</td>",
      "                        <td>",
      "                            @if(\\$item->${4:image})",
      "                                <img src=\"{{ asset('storage/' . \\$item->${4:image}) }}\" width=\"60\" class=\"rounded\">",
      "                            @else",
      "                                <span class=\"text-muted\">No Image</span>",
      "                            @endif",
      "                        </td>",
      "                        <td>{{ \\$item->${5:title} }}</td>",
      "                        <td>",
      "                            <a href=\"{{ route('${3:route_prefix}.edit', \\$item->id) }}\" class=\"btn btn-sm btn-warning\">Edit</a>",
      "                            <form action=\"{{ route('${3:route_prefix}.destroy', \\$item->id) }}\" method=\"POST\" class=\"d-inline\" onsubmit=\"return confirm('Delete item?')\">",
      "                                @csrf",
      "                                @method('DELETE')",
      "                                <button type=\"submit\" class=\"btn btn-sm btn-danger\">Delete</button>",
      "                            </form>",
      "                        </td>",
      "                    </tr>",
      "                @empty",
      "                    <tr>",
      "                        <td colspan=\"4\" class=\"text-center\">No data found.</td>",
      "                    </tr>",
      "                @endforelse",
      "            </tbody>",
      "        </table>",
      "        {{ \\$items->links() }}",
      "    </div>",
      "</div>",
      "@endsection"
    ],
    "description": "Complete CRUD Index View Table"
  },

